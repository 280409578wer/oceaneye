# V0.1 默认使用 Mock 数据，无需任何密钥即可运行
DATA_SOURCE=mock
MOCK_ENABLED=true
MOCK_INTERVAL_SECONDS=10

# 默认使用 data/oceaneye.db；只有需要自定义位置时才取消下一行注释
# DATABASE_URL=sqlite:///C:/path/to/oceaneye.db

# 真实巨量接口（当前仅预留，接入时必须参考最新官方文档）
OCEANENGINE_APP_ID=
OCEANENGINE_SECRET=
OCEANENGINE_ACCESS_TOKEN=
OCEANENGINE_ADVERTISER_ID=

# AI 接口（留空时使用本地规则分析）
AI_PROVIDER=rules
AI_API_KEY=
AI_MODEL=
